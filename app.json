{
  "expo": {
    "name": "Tez Jumush",
    "slug": "tez-jumush",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./frontend/assets/icon.png",
    "userInterfaceStyle": "light",
    "sdkVersion": "54.0.0",
    "jsEngine": "hermes",
    "splash": {
      "image": "./frontend/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#007AFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tezjumush.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Это приложение использует геолокацию для показа ближайших задач на карте.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Это приложение использует геолокацию для показа ближайших задач на карте."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./frontend/assets/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.tezjumush.app"
    },
    "web": {
      "favicon": "./frontend/assets/favicon.png"
    },
    "scheme": "tezjumush",
    "plugins": [
      [
      "expo-location",
          {
          "locationAlwaysAndWhenInUsePermission": "Это приложение использует геолокацию для показа ближайших задач на карте."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложение использует камеру для добавления фотографий паспорта."
        }
      ],
      "expo-web-browser"
    ]
  }
}
