{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:web": "expo start --web",
    "start:tunnel": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "start:iphone": "expo start --tunnel --clear",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:build": "webpack --mode=production",
    "web:dev": "webpack serve --mode=development",
    "web:pwa": "expo start --web --pwa",
    "build:pwa": "npm run web:build && npm run copy:assets",
    "copy:assets": "cp -r public/* dist/",
    "serve:pwa": "serve -s dist -l 3000"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "expo": "~54.0.31",
    "expo-asset": "~12.0.9",
    "expo-auth-session": "~7.0.10",
    "expo-constants": "~18.0.9",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "^6.0.20",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.9",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendar-picker": "^8.0.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "workbox-webpack-plugin": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-react": "^7.18.0",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.7.0",
    "file-loader": "^6.2.0",
    "react-native-web": "^0.21.0",
    "serve": "^14.2.0",
    "style-loader": "^3.3.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^5.2.2"
  },
  "private": true
}
