# API Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_API_TIMEOUT=30000

# Google OAuth Configuration
# Получите эти ID в Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# App Configuration
EXPO_PUBLIC_APP_NAME=Tez Jumush
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_ENVIRONMENT=development

# Feature Flags
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=true
EXPO_PUBLIC_ENABLE_SMS_VERIFICATION=true
EXPO_PUBLIC_ENABLE_GEOLOCATION=true

# Debug Settings
EXPO_PUBLIC_DEBUG_API_CALLS=true
EXPO_PUBLIC_DEBUG_STORAGE=true
EXPO_PUBLIC_DEBUG_NAVIGATION=false

# Network Settings
EXPO_PUBLIC_SYNC_INTERVAL=30000
EXPO_PUBLIC_MAX_RETRY_ATTEMPTS=3
EXPO_PUBLIC_RETRY_DELAY=1000